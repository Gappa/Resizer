{
	"name": "nelson/resizer",
	"description": "Resizer Extension for Nette Framework & Latte",
	"type": "library",
	"require": {
		"php": "^8.5",
		"ext-fileinfo": "*",
		"latte/latte": "^3.1.7",
		"nette/application": "^3.3.1",
		"nette/di": "^3.2.8",
		"nette/http": "^3.4.2",
		"nette/schema": "^1.4",
		"nette/utils": "^4.1.6",
		"imagine/imagine": "^1.5.4"
	},
	"require-dev": {
		"phpstan/extension-installer": "^1.4.3",
		"phpstan/phpstan": "^2.3",
		"phpstan/phpstan-nette": "^2.0.15",
		"roave/security-advisories": "dev-latest",
		"phpunit/phpunit": "^13.4",
		"symfony/console": "^7.4 || ^8.0",
		"tracy/tracy": "^2.12"
	},
	"suggest": {
		"ext-imagick": "Imagick library (recommended, required for JPEG XL)",
		"ext-gd": "GD library",
		"ext-gmagick": "Gmagick library",
		"ext-exif": "EXIF orientation of photos with GD and Gmagick (Imagick reads it on its own)",
		"contributte/console": "resizer:clean command (any symfony/console integration works)"
	},
	"autoload": {
		"psr-4": {
			"Nelson\\Resizer\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": { "Nelson\\Resizer\\Tests\\": "tests/" }
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
